{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pocket Party content pack v1/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "version",
    "name",
    "ruleset",
    "isPrivate",
    "attribution",
    "coverageNotes",
    "classes",
    "species",
    "backgrounds",
    "feats",
    "spells",
    "languages"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        1,
        2
      ]
    },
    "capabilities": {
      "$ref": "#/$defs/packCapabilities"
    },
    "id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "ruleset": {
      "enum": [
        "2014",
        "2024"
      ]
    },
    "isPrivate": {
      "type": "boolean"
    },
    "attribution": {
      "type": "string"
    },
    "coverageNotes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "classes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/class"
      }
    },
    "species": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/species"
      }
    },
    "backgrounds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/background"
      }
    },
    "feats": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/feat"
      }
    },
    "spells": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/spell"
      }
    },
    "languages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "items": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "ruleset": {
            "const": "2024"
          },
          "classes": {
            "type": "array",
            "items": {
              "properties": {
                "progression": {
                  "type": "array",
                  "items": {
                    "properties": {
                      "level": {
                        "maximum": 5
                      }
                    }
                  }
                },
                "subclassLevel": {
                  "minimum": 1,
                  "maximum": 5
                }
              }
            }
          },
          "feats": {
            "type": "array",
            "items": {
              "properties": {
                "minimumLevel": {
                  "minimum": 1,
                  "maximum": 5
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 2
          }
        }
      },
      "then": {
        "required": [
          "capabilities"
        ]
      }
    },
    {
      "if": {
        "required": [
          "items"
        ]
      },
      "then": {
        "properties": {
          "schemaVersion": {
            "const": 2
          },
          "capabilities": {
            "properties": {
              "required": {
                "contains": {
                  "const": "equipment"
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "text",
        "level"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "level": {
          "type": "integer"
        },
        "canonicalID": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "talent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "text",
        "minimumLevel",
        "exclusiveGroup",
        "skills",
        "requires"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "minimumLevel": {
          "type": "integer"
        },
        "exclusiveGroup": {
          "type": "string"
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "spell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "text",
        "level",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "level": {
          "type": "integer"
        },
        "source": {
          "type": "string"
        },
        "unavailableReason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "spellIDs"
      ],
      "properties": {
        "level": {
          "type": "integer"
        },
        "spellIDs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "subclass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "text",
        "features",
        "spells"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/feature"
          }
        },
        "spells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/grant"
          }
        },
        "capabilities": {
          "$ref": "#/$defs/definitionCapabilities"
        }
      }
    },
    "progression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "talents",
        "cantrips",
        "spells",
        "slots",
        "slotLevel",
        "improvement"
      ],
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "talents": {
          "type": "integer"
        },
        "cantrips": {
          "type": "integer"
        },
        "spells": {
          "type": "integer"
        },
        "slots": {
          "type": "integer"
        },
        "slotLevel": {
          "type": "integer"
        },
        "improvement": {
          "type": "boolean"
        }
      }
    },
    "class": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "summary",
        "hitDie",
        "primaryAbility",
        "saves",
        "skillCount",
        "skillPool",
        "subclassLevel",
        "talentLabel",
        "features",
        "talents",
        "subclasses",
        "progression",
        "spellIDs",
        "equipment",
        "armorFormula"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "hitDie": {
          "enum": [
            6,
            8,
            10,
            12
          ]
        },
        "primaryAbility": {
          "enum": [
            "str",
            "dex",
            "con",
            "int",
            "wis",
            "cha"
          ]
        },
        "spellAbility": {
          "anyOf": [
            {
              "enum": [
                "str",
                "dex",
                "con",
                "int",
                "wis",
                "cha"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "saves": {
          "type": "array",
          "items": {
            "enum": [
              "str",
              "dex",
              "con",
              "int",
              "wis",
              "cha"
            ]
          }
        },
        "skillCount": {
          "type": "integer"
        },
        "skillPool": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "subclassLevel": {
          "type": "integer"
        },
        "talentLabel": {
          "type": "string"
        },
        "features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/feature"
          }
        },
        "talents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/talent"
          }
        },
        "subclasses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/subclass"
          }
        },
        "progression": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/progression"
          }
        },
        "spellIDs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "equipment": {
          "type": "string"
        },
        "armorFormula": {
          "enum": [
            "unarmored",
            "vessel-mantle"
          ]
        },
        "multiclass": {
          "$ref": "#/$defs/multiclass"
        },
        "capabilities": {
          "$ref": "#/$defs/definitionCapabilities"
        },
        "startingEquipment": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/equipmentChoice"
          }
        }
      }
    },
    "species": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "text",
        "speed",
        "hpPerLevel",
        "size"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "speed": {
          "type": "integer"
        },
        "hpPerLevel": {
          "type": "integer"
        },
        "size": {
          "type": "string"
        },
        "capabilities": {
          "$ref": "#/$defs/definitionCapabilities"
        }
      }
    },
    "background": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "text",
        "abilities",
        "skills",
        "tool",
        "originFeatID",
        "equipment"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "abilities": {
          "type": "array",
          "items": {
            "enum": [
              "str",
              "dex",
              "con",
              "int",
              "wis",
              "cha"
            ]
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tool": {
          "type": "string"
        },
        "originFeatID": {
          "type": "string"
        },
        "equipment": {
          "type": "string"
        },
        "capabilities": {
          "$ref": "#/$defs/definitionCapabilities"
        },
        "startingEquipment": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/equipmentChoice"
          }
        }
      }
    },
    "feat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "text",
        "category",
        "minimumLevel",
        "abilityOptions",
        "abilityPoints",
        "hpPerLevel",
        "initiativeProficiency",
        "skills",
        "abilityMinimums"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "category": {
          "enum": [
            "origin",
            "general"
          ]
        },
        "minimumLevel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "abilityOptions": {
          "type": "array",
          "items": {
            "enum": [
              "str",
              "dex",
              "con",
              "int",
              "wis",
              "cha"
            ]
          }
        },
        "abilityPoints": {
          "type": "integer"
        },
        "hpPerLevel": {
          "type": "integer"
        },
        "initiativeProficiency": {
          "type": "boolean"
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "abilityMinimums": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "str",
              "dex",
              "con",
              "int",
              "wis",
              "cha"
            ]
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          }
        },
        "repeatable": {
          "type": "boolean"
        },
        "capabilities": {
          "$ref": "#/$defs/definitionCapabilities"
        }
      }
    },
    "ruleValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "base": {
          "type": "integer"
        },
        "abilities": {
          "type": "array",
          "items": {
            "enum": [
              "str",
              "dex",
              "con",
              "int",
              "wis",
              "cha"
            ]
          }
        },
        "levelMultiplier": {
          "type": "integer"
        },
        "proficiencyMultiplier": {
          "type": "integer"
        },
        "table": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "maxItems": 20
        },
        "minimum": {
          "type": "integer"
        }
      }
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "all",
            "any",
            "not",
            "level",
            "ability",
            "selection",
            "proficiency",
            "configuration",
            "subclass",
            "equipment"
          ]
        },
        "key": {
          "type": "string"
        },
        "minimum": {
          "type": "integer"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/predicate"
          }
        }
      }
    },
    "capabilityGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "proficiency",
            "skillAbility",
            "skillBonus",
            "armorFormula",
            "armorBonus",
            "hitPoints",
            "initiative",
            "speed",
            "speedBase",
            "abilityScore",
            "trait",
            "resource",
            "spell",
            "unsupported",
            "manual",
            "size",
            "language",
            "abilityCap",
            "equipment"
          ]
        },
        "target": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/ruleValue"
        },
        "rank": {
          "enum": [
            "none",
            "half",
            "proficient",
            "expertise"
          ]
        },
        "ability": {
          "enum": [
            "str",
            "dex",
            "con",
            "int",
            "wis",
            "cha"
          ]
        },
        "condition": {
          "$ref": "#/$defs/predicate"
        },
        "level": {
          "type": "integer"
        },
        "text": {
          "type": "string"
        },
        "recovery": {
          "type": "string"
        },
        "spellMode": {
          "enum": [
            "granted",
            "prepared",
            "atWill",
            "limited",
            "ritual"
          ]
        },
        "equipment": {
          "$ref": "#/$defs/equipmentRule"
        }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "text",
        "grants"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "prerequisite": {
          "$ref": "#/$defs/predicate"
        },
        "grants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capabilityGrant"
          }
        },
        "repeatable": {
          "type": "boolean"
        },
        "exclusiveGroup": {
          "type": "string"
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "counts",
        "options"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "counts": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "maxItems": 20
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "replacementLimits": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "maxItems": 20
        },
        "condition": {
          "$ref": "#/$defs/predicate"
        },
        "locked": {
          "type": "boolean"
        },
        "requiredOptionID": {
          "type": "string"
        },
        "languageChoices": {
          "type": "boolean"
        },
        "requiredOptionIDs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "waiveRequiredFamilyIfOwned": {
          "type": "boolean"
        },
        "requirementTiming": {
          "enum": [
            "ongoing",
            "acquisition"
          ]
        },
        "exclusiveGroupExceptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "prerequisite": {
          "$ref": "#/$defs/predicate"
        },
        "exclusiveGroup": {
          "type": "string"
        }
      }
    },
    "casting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "mode",
        "ability",
        "spellIDs",
        "counts",
        "maximumSpellLevels"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "known",
            "prepared",
            "book",
            "granted",
            "ritual",
            "limited",
            "atWill"
          ]
        },
        "ability": {
          "enum": [
            "str",
            "dex",
            "con",
            "int",
            "wis",
            "cha"
          ]
        },
        "spellIDs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "counts": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "maxItems": 20
        },
        "maximumSpellLevels": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "maxItems": 20
        },
        "replacementLimits": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "maxItems": 20
        },
        "preparedCounts": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "maxItems": 20
        },
        "condition": {
          "$ref": "#/$defs/predicate"
        },
        "text": {
          "type": "string"
        },
        "loadout": {
          "enum": [
            "editable",
            "retained"
          ]
        },
        "poolIDs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preparation": {
          "$ref": "#/$defs/ruleValue"
        },
        "alwaysGrantedSpellIDs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "legacyClassCasting": {
          "enum": [
            "preserve",
            "replace"
          ]
        }
      }
    },
    "spellPool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "recovery",
        "capacities"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "kind": {
          "enum": [
            "ordinary",
            "pact",
            "limited",
            "custom"
          ]
        },
        "recovery": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "capacities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[1-9]$"
            },
            "additionalProperties": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "maxProperties": 9
          }
        },
        "condition": {
          "$ref": "#/$defs/predicate"
        }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edition",
        "canonicalID",
        "label",
        "replacementGrants"
      ],
      "properties": {
        "edition": {
          "enum": [
            "2014",
            "2024"
          ]
